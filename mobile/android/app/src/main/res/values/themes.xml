<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sign2Text.Base" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/primary_light</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="android:windowBackground">@color/welcome_bg</item>
    </style>

    <style name="Theme.Sign2Text.Onboarding" parent="Theme.Sign2Text.Base">
        <item name="android:statusBarColor">@color/welcome_bg</item>
        <item name="android:navigationBarColor">@color/welcome_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Sign2Text.Camera" parent="Theme.Sign2Text.Base">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/camera_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Sign2Text" parent="Theme.Sign2Text.Camera" />

    <style name="Widget.Sign2Text.WordSave" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/action_pill_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="elevation">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Sign2Text.WordClear" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/action_pill_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">24dp</item>
        <item name="strokeColor">@color/word_toggle_outline</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="rippleColor">@color/primary_light</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Sign2Text.WordBackspace" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/word_panel_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_headline</item>
        <item name="rippleColor">@color/primary_light</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <style name="Widget.Sign2Text.Button.Filled" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="iconTint">@color/on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="elevation">0dp</item>
        <item name="cornerRadius">28dp</item>
    </style>
</resources>
